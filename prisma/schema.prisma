// AbitaRE Investor Club — schema
// Principi (stessi del CRM):
// - Tutte le tabelle hanno prefisso Club: all'integrazione si trasferiscono nel
//   database del CRM con migrazioni solo additive.
// - Niente enum Prisma: campi String con i valori canonici elencati nel commento.
// - clienteId / *UserId = id (cuid, String) di Cliente / User nel CRM. Nessuna
//   foreign key: oggi le tabelle del CRM stanno in un altro database.
// - Riferimento all'investitore (profilo, link, eventi): clienteId per i
//   clienti del CRM, contattoNuovoId per i nuovi investitori della lista
//   temporanea (ClubContattoNuovo). In profilo e link esattamente uno dei due
//   e' valorizzato (vincolo CHECK scritto nella migrazione).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("CLUB_DATABASE_URL")
}

// Profilo d'investimento: una riga per investitore.
model ClubProfiloInvestitore {
  id              String  @id @default(cuid())
  clienteId       String? @unique
  contattoNuovoId String? @unique

  obiettivo             String? // flipping | rendita | entrambi
  capitale              String? // 0-50k | 50-100k | 100-150k | 150-200k | 200-300k | 300-500k | oltre-500k
  rendimentoFlipping    String? // fino-12 | 12-18 | 18-25 | oltre-25
  rendimentoRendita     String? // 3-5 | 5-7 | 7-9 | oltre-9
  finanziamento         String? // necessario | possibile | non-necessario
  // DISMESSO: non piu' mostrato ne' contato, resta solo come storico.
  // Sostituito da orizzonteFlipping / orizzonteRendita.
  orizzonte             String? // meno-12-mesi | 1-3-anni | 3-5-anni | oltre-5-anni
  orizzonteFlipping     String? // meno-12-mesi | fino-18-mesi | fino-24-mesi | oltre-24-mesi
  orizzonteRendita      String? // 1-3-anni | 3-5-anni | oltre-5-anni
  area                  String? // italia | estero | entrambi
  formulaFlipping       String? // intera | quota | indifferente
  tipoRendita           String? // lungo-periodo | breve-periodo | indifferente
  coinvolgimento        String? // passivo | attivo
  esperienza            String? // nessuna | qualche-operazione | abituale
  disponibilitaCapitale String? // subito | entro-3-mesi | entro-6-mesi | oltre
  contattoPreferito     String? // whatsapp | telefono | email
  interesseGoldenVisa   Boolean?

  // CONSENSI: il booleano e la data in cui e' stato dato.
  consensoProfilazione    Boolean   @default(false)
  consensoProfilazioneIl  DateTime?
  consensoComunicazioni   Boolean   @default(false)
  consensoComunicazioniIl DateTime?

  completatoIl         DateTime?
  ultimaModificaDa     String? // consulente | cliente
  ultimaModificaUserId String? // id User del CRM, se ha modificato un consulente

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Link personale che il consulente manda al cliente per compilare il profilo.
model ClubLinkInvito {
  id              String    @id @default(cuid())
  token           String    @unique // casuale, sicuro, almeno 32 caratteri
  clienteId       String?
  contattoNuovoId String?
  creatoDaUserId  String
  creatoIl        DateTime  @default(now())
  revocatoIl      DateTime?
  ultimoAccessoIl DateTime?
  accessiTotali   Int       @default(0)

  @@index([clienteId])
  @@index([contattoNuovoId])
}

// Disiscrizione dalle proposte di operazioni: un token personale per
// investitore (link /stop/<token> nel messaggio WhatsApp, solo a portale
// attivo). disiscrittoIl valorizzato = non riceve piu' proposte: non compare
// tra i compatibili e non gli si puo' proporre nulla. Lo decide solo il
// cliente, dalla stessa pagina puo' anche riattivarsi.
model ClubDisiscrizione {
  id              String    @id @default(cuid())
  token           String    @unique // casuale, sicuro, almeno 32 caratteri
  clienteId       String?   @unique
  contattoNuovoId String?   @unique
  disiscrittoIl   DateTime?
  creatoIl        DateTime  @default(now())
}

// Diario degli eventi del Club, per investitore. Gli eventi generali
// (impostazione-modificata) non hanno ne' clienteId ne' contattoNuovoId.
// Gli eventi delle operazioni hanno operazioneId (e, per operazione-proposta,
// anche l'investitore a cui e' stata proposta).
model ClubEvento {
  id              String   @id @default(cuid())
  clienteId       String?
  contattoNuovoId String?
  operazioneId    String?
  tipo            String // link-creato | link-revocato | link-aperto | passo-completato | profilo-completato | profilo-modificato-consulente | nuovo-investitore-creato | nuovo-investitore-modificato | nuovo-investitore-confermato | nuovo-investitore-scartato | registrazione-doppione | codice-invito-rigenerato | impostazione-modificata | operazione-creata | operazione-modificata | operazione-inviata-in-revisione | operazione-pubblicata | operazione-raccolta-chiusa | operazione-conclusa | operazione-ritirata | operazione-proposta | proposte-disattivate | proposte-riattivate
  dati            Json?
  creatoIl        DateTime @default(now())

  @@index([clienteId])
  @@index([contattoNuovoId])
  @@index([operazioneId])
  @@index([creatoIl])
}

// Operazione d'investimento del catalogo (area interna; nella fase 4b anche
// nel portale cliente). Importi in euro interi; rendimenti annui stimati in %
// con due decimali, mai garantiti. Regole e permessi in src/lib/operazioni/ e
// src/lib/permessi.ts.
model ClubOperazione {
  id           String  @id @default(cuid())
  codice       String  @unique // OP-<anno>-<progressivo a 3 cifre>, es. OP-2026-001
  titolo       String
  tipo         String // flipping | rendita-lungo | rendita-breve
  paese        String
  citta        String?
  zona         String?
  partner      String // abitare | safehouse | altro
  partnerAltro String?
  formula      String // intera | quota

  // Solo per formula = quota.
  numeroMaxSoci        Int?
  quotaMinima          Int?
  importoDaRaccogliere Int?
  importoImpegnato     Int? // aggiornato a mano in questa fase

  prezzoAcquisto         Int?
  costiLavori            Int?
  altriCosti             Int?
  capitaleRichiesto      Int?
  valoreRivenditaStimato Int? // flipping
  canoneAnnuoStimato     Int? // rendita

  rendimentoPessimista Decimal? @db.Decimal(6, 2)
  rendimentoBase       Decimal? @db.Decimal(6, 2)
  rendimentoOttimista  Decimal? @db.Decimal(6, 2)
  durataStimataMesi    Int?
  finanziabile         Boolean  @default(false)

  descrizione      String?
  puntiDiForza     String?
  rischi           String? // obbligatorio per pubblicare
  scadenzaRaccolta DateTime?

  // Sezione estero: solo per paese diverso da Italia (altrimenti vuoti).
  // Gli importi restano in euro; cambioEuro = unita' di valuta locale per 1 euro.
  valutaLocale     String? // codice ISO, es. AED
  cambioEuro       Decimal?  @db.Decimal(12, 4)
  sviluppatore     String?
  consegnaPrevista DateTime?
  pianoPagamento   String?
  goldenVisa       Boolean? // null = non indicato
  noteFiscali      String?

  referenteUserId String? // id User del CRM
  stato           String  @default("bozza") // bozza | in-revisione | pubblicata | raccolta-chiusa | conclusa | ritirata

  creatoDaUserId     String // id User del CRM
  pubblicataIl       DateTime?
  pubblicataDaUserId String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  file ClubOperazioneFile[]

  @@index([stato])
}

// Foto e documenti di un'operazione, nell'archivio privato su Cloudflare R2
// (src/lib/archivio.ts). Si vedono solo con link firmati generati dall'app
// dopo il controllo dei permessi. Visibilita' per il cliente (fase 4b):
// anteprima = nella scheda sintetica; riservato = solo dopo la manifestazione
// d'interesse.
model ClubOperazioneFile {
  id               String   @id @default(cuid())
  operazioneId     String
  tipo             String // foto | documento
  visibilita       String   @default("riservato") // anteprima | riservato
  nome             String // nome originale del file, mostrato
  chiaveArchivio   String   @unique
  dimensione       Int // byte
  ordine           Int      @default(0)
  caricatoDaUserId String
  createdAt        DateTime @default(now())

  operazione ClubOperazione @relation(fields: [operazioneId], references: [id])

  @@index([operazioneId, tipo, ordine])
}

// Impostazioni e feature flag (chiave/valore, chiavi in italiano camelCase).
model ClubImpostazione {
  id           String   @id @default(cuid())
  chiave       String   @unique
  valore       String
  aggiornatoIl DateTime @updatedAt
}

// Nuovi investitori inseriti dal Club e non ancora presenti nel CRM (lista
// temporanea, modalitaNuoviInvestitori = "lista-temporanea"). Contiene cio'
// che serve per creare il Cliente nel CRM (fonte "Investor Club", ruolo
// "Investitore") al primo collegamento in scrittura: crmClienteId e
// importatoIl si compilano in quel momento.
model ClubContattoNuovo {
  id                 String    @id @default(cuid())
  nome               String
  cognome            String
  cellulare          String // salvato con cellulareDaSalvare (src/lib/telefono.ts)
  email              String?
  note               String?
  referenteUserId    String // id User del CRM
  creatoDaUserId     String // id User del CRM
  stato              String    @default("confermato") // da-confermare | confermato | importato
  // Consenso al contatto dato da chi si registra da solo (/entra/<codice>).
  consensoContattoIl DateTime?
  crmClienteId       String?
  importatoIl        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([cellulare])
  @@index([referenteUserId])
}

// Link personale di un utente CRM per far registrare nuovi investitori
// (/entra/<codice>). Un solo codice attivo per utente (indice unico parziale
// scritto nella migrazione); "Rigenera link" disattiva il vecchio.
model ClubCodiceInvito {
  id        String   @id @default(cuid())
  userId    String // id User del CRM: referente di chi si registra
  codice    String   @unique // casuale, non indovinabile, almeno 10 caratteri
  attivo    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
}

// Tentativi di login falliti, per il limite di 5 in 15 minuti per email o IP
// (src/lib/limite-login.ts). "chiave" e' un'impronta HMAC: email e IP non sono
// salvati in chiaro. I record piu' vecchi della finestra vengono cancellati.
model ClubTentativoAccesso {
  id       String   @id @default(cuid())
  chiave   String
  creatoIl DateTime @default(now())

  @@index([chiave, creatoIl])
  @@index([creatoIl])
}
